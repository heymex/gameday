# Copy to .env and fill in real values. .env is gitignored.
# Shared SNMPv2c community (override per series with BASELINE_COMMUNITY, etc.)
SNMP_COMMUNITY=changeme

LISTEN_ADDR=:8080

# Broadcast gear access port on the closet switch.
# Dumb switch → this port → closet → dist → core → DMZ → ISP.
# DIR=out = ifHCOutOctets on that port (upstream toward the ISP path).
BASELINE_HOST=10.0.10.2
BASELINE_IFINDEX=10101
BASELINE_DIR=out

# Distribution → core Port-channel (upstream / toward ISP).
DIST_CORE_HOST=10.0.10.3
DIST_CORE_IFINDEX=5001
DIST_CORE_DIR=out

# DMZ / edge → ISP Port-channel (upload toward ISP).
DMZ_ISP_HOST=10.0.10.5
DMZ_ISP_IFINDEX=5002
DMZ_ISP_DIR=out
